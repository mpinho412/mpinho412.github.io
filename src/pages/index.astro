          <p class="about-text">
            Hello! I am Miguel, an Industrial and Systems Engineering student at Virginia Tech,
            originally from Sewickley, Pennsylvania. I am drawn to the places where process, data,
            and people meet - writing SOPs on a plant floor, mapping ERP data flows, or coordinating
            an engineering week for hundreds of students. I have interned in supply chain and process
            improvement at an abrasive minerals manufacturer and externed as a project engineer on a
            large-scale construction project. I am a Six Sigma Green Belt, I speak Portuguese,
            English, and Spanish, and I am always looking for the next opportunity to make a system
            run better.
          </p>
        </div>
      </section>

      <section class="section" id="education">
        <div class="wrap">
          <p class="kicker">Where I study</p>
          <h2 class="h2">Education</h2>
          <div class="timeline">
            <article class="job">
              <div class="job-head">
                <h3>Virginia Tech - B.S. in Industrial and Systems Engineering</h3>
                <span class="dates">Expected May 2029</span>
              </div>
              <p class="org">Blacksburg, VA</p>
              <ul>
                <li>Cumulative GPA: 3.62</li>
                <li>Fall 2025 Dean's List with Distinction</li>
                <li>Six Sigma Green Belt certified through IISE</li>
              </ul>
            </article>
          </div>
        </div>
      </section>

      <section class="section" id="experience">
        <div class="wrap">
          <p class="kicker">Explore my</p>
          <h2 class="h2">Experience</h2>
          <div class="timeline">
            {experience.map((job) => (
              <article class="job">
                <div class="job-head">
                  <h3>{job.role}</h3>
                  <span class="dates">{job.dates}</span>
                </div>
                <p class="org">{job.org}</p>
                <ul>
                  {job.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </article>
            ))}
          </div>

          <a
            class="sec-badge"
            href={secProfile}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Miguel Pinho on the Virginia Tech Student Engineers' Council website"
          >
            <span class="sec-mark">VT</span>
            <span class="sec-copy">
              <strong>Student Engineers' Council</strong>
              <small>Virginia Tech College of Engineering</small>
            </span>
            <span class="sec-arrow">View my leadership profile &rarr;</span>
          </a>
        </div>
      </section>

      <section class="section" id="projects">
        <div class="wrap">
          <p class="kicker">What I have built</p>
          <h2 class="h2">Projects</h2>
          <div class="projects">
            {projects.map((p) => (
              <article class="project">
                <div class="project-head">
                  <h3>{p.title}</h3>
                  <p class="org">{p.org}</p>
                  <span class="project-role">{p.role}</span>
                </div>
                <div class="project-body">
                  {p.summary.map((s) => <p>{s}</p>)}
                </div>
                <ul class="chips tags">
                  {p.tags.map((t) => <li>{t}</li>)}
                </ul>
                <div class="slideshow" data-slideshow>
                  <div class="slide-track">
                    {p.slides.map((s, i) => (
                      <img class={i === 0 ? "slide is-active" : "slide"} src={s.src} alt={s.alt} loading="lazy" />
                    ))}
                  </div>
                  <button class="slide-nav prev" type="button" aria-label="Previous slide" set:html={CHEV_L} />
                  <button class="slide-nav next" type="button" aria-label="Next slide" set:html={CHEV_R} />
                  <div class="slide-dots">
                    {p.slides.map((s, i) => (
                      <button class={i === 0 ? "dot is-active" : "dot"} type="button" aria-label={"Go to slide " + (i + 1)}></button>
                    ))}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="leadership">
        <div class="wrap">
          <p class="kicker">Beyond the classroom</p>
          <h2 class="h2">Leadership &amp; Community Impact</h2>
          <div class="timeline">
            {leadership.map((job) => (
              <article class="job">
                <div class="job-head">
                  <h3>{job.role}</h3>
                  <span class="dates">{job.dates}</span>
                </div>
                <p class="org">{job.org}</p>
                <ul>
                  {job.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="skills">
        <div class="wrap">
          <p class="kicker">What I bring</p>
          <h2 class="h2">Core Skills</h2>
          <div class="skill-grid">
            {skillGroups.map((group) => (
              <div class="skill-card">
                <h3>{group.title}</h3>
                <ul class="chips">
                  {group.items.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="awards">
        <div class="wrap">
          <p class="kicker">Certifications and honors</p>
          <h2 class="h2">Awards</h2>

          <div class="cred">
            <button class="badge-btn" type="button" data-cert-open aria-label="Preview my Six Sigma Green Belt certificate">
              <img src="/six-sigma-green-belt.png" alt="Six Sigma Green Belt - IISE Certified badge" width="340" height="340" />
            </button>
            <p class="badge-cap">Click the badge to preview the certificate</p>
          </div>

          <ul class="awards">
            {awards.map((a) => (
              <li>
                <span>
                  <span class="a-name">
                    {a.link ? <a href={a.link} target="_blank" rel="noopener noreferrer">{a.name}</a> : a.name}
                  </span>
                  <span class="a-sub">{a.sub}</span>
                  {a.note && <span class="a-note">{a.note}</span>}
                </span>
                <span class="a-date">{a.date}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section" id="contact">
        <div class="wrap">
          <p class="kicker">Get in touch</p>
          <h2 class="h2">Contact Me</h2>
          <div class="contact">
            <a class="contact-row" href={"mailto:" + email}>
              <Fragment set:html={MAIL} />
              <span>{email}</span>
            </a>
            <a class="contact-row" href={"mailto:" + altEmail}>
              <Fragment set:html={MAIL} />
              <span>{altEmail}</span>
            </a>
            <a class="contact-row" href={"tel:" + phone}>
              <Fragment set:html={PHONE} />
              <span>{phone}</span>
            </a>
            <a class="contact-row" href={linkedin} target="_blank" rel="noopener noreferrer">
              <Fragment set:html={LI} />
              <span>linkedin.com/in/miguel-pinho1</span>
            </a>
            <div class="contact-row">
              <Fragment set:html={PIN} />
              <span>Sewickley, PA</span>
            </div>
          </div>
        </div>
      </section>
    </main>

    <div class="cert-modal" id="certModal" hidden>
      <div class="cert-backdrop" data-close></div>
      <div class="cert-dialog" role="dialog" aria-modal="true" aria-label="Six Sigma Green Belt certificate preview">
        <button class="cert-close" type="button" data-close aria-label="Close preview">&times;</button>
        <div class="cert-paper">
          <p class="cert-issuer">Institute of Industrial and Systems Engineers</p>
          <h3 class="cert-title">Six Sigma Green Belt</h3>
          <p class="cert-sub">Certificate</p>
          <p class="cert-line">is hereby granted to</p>
          <p class="cert-name">Miguel Pinho</p>
          <p class="cert-line">In recognition of the mastery of the<br />Six Sigma Green Belt body of knowledge</p>
          <div class="cert-meta">
            <div><span>April 13, 2026</span><small>Issue Date &middot; Expires 04/12/2029</small></div>
            <img src="/six-sigma-green-belt.png" alt="Six Sigma Green Belt badge" />
            <div><span>James Swisher</span><small>Continuing Education Director</small></div>
          </div>
          <p class="cert-id">Certificate ID: 179698732</p>
        </div>
        <a class="btn btn-solid" href={sixSigmaCert} target="_blank" rel="noopener noreferrer">View verified credential</a>
      </div>
    </div>

    <footer>
      <div class="wrap">
        <p>Miguel Pinho &middot; Built with Astro and hosted on GitHub Pages</p>
      </div>
    </footer>

    <script is:inline>
      document.querySelectorAll("[data-slideshow]").forEach(function (box) {
        var slides = box.querySelectorAll(".slide");
        var dots = box.querySelectorAll(".dot");
        var i = 0;
        function show(n) {
          i = (n + slides.length) % slides.length;
          slides.forEach(function (s, k) { s.classList.toggle("is-active", k === i); });
          dots.forEach(function (d, k) { d.classList.toggle("is-active", k === i); });
        }
        var prev = box.querySelector(".prev");
        var next = box.querySelector(".next");
        if (prev) prev.addEventListener("click", function () { show(i - 1); });
        if (next) next.addEventListener("click", function () { show(i + 1); });
        dots.forEach(function (d, k) { d.addEventListener("click", function () { show(k); }); });
      });

      (function () {
        var modal = document.getElementById("certModal");
        if (!modal) return;
        function open() { modal.hidden = false; document.body.style.overflow = "hidden"; }
        function close() { modal.hidden = true; document.body.style.overflow = ""; }
        document.querySelectorAll("[data-cert-open]").forEach(function (b) { b.addEventListener("click", open); });
        modal.querySelectorAll("[data-close]").forEach(function (b) { b.addEventListener("click", close); });
        document.addEventListener("keydown", function (e) { if (e.key === "Escape") close(); });
      })();
    </script>
  </body>
</html>
