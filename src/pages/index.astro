---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Miguel Pinho | Industrial &amp; Systems Engineering Student</title>
    <meta
      name="description"
      content="Portfolio of Miguel Pinho, an Industrial and Systems Engineering student at Virginia Tech focused on process improvement, supply chain, and operations."
    />
    <link rel="canonical" href="https://mpinho412.github.io/" />
  </head>

  <body id="top">
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href="#top">Miguel Pinho</a>
        <nav aria-label="Main">
          <ul class="nav-links">
            <li><a href="#about">About</a></li>
            <li><a href="#education">Education</a></li>
            <li><a href="#experience">Experience</a></li>
            <li><a href="#leadership">Leadership</a></li>
            <li><a href="#skills">Skills</a></li>
            <li><a href="#awards">Awards</a></li>
            <li><a href="#contact">Contact</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="wrap hero-inner">
          <div class="portrait">
            <img src="/profile.jpg" alt="Portrait of Miguel Pinho" width="660" height="880" />
          </div>
          <div>
            <p class="hello">Hello, I'm</p>
            <h1>Miguel Pinho</h1>
            <p class="role">Industrial &amp; Systems Engineering Student at Virginia Tech</p>
            <p class="meta">Blacksburg, VA &middot; Sewickley, PA &middot; Expected graduation May 2029</p>
            <div class="btns">
              <a class="btn btn-ghost" href="#experience">View My Experience</a>
              <a class="btn btn-solid" href={"mailto:" + email}>Contact Me</a>
            </div>
            <ul class="socials">
              <li>
                <a href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile" set:html={LI} />
              </li>
              <li>
                <a href={github} target="_blank" rel="noopener noreferrer" aria-label="GitHub profile" set:html={GH} />
              </li>
              <li>
                <a href={"mailto:" + email} aria-label="Email Miguel" set:html={MAIL} />
              </li>
            </ul>
          </div>
        </div>
      </section>

      <section class="section" id="about">
        <div class="wrap">
          <p class="kicker">Get to know more</p>
          <h2 class="h2">About Me</h2>
          <div class="stats">
            {highlights.map((h) => (
              <div class="stat">
                <div class="label">{h.label}</div>
                <h3>{h.title}</h3>
                <p>{h.text}</p>
              </div>
            ))}
          </div>
          <p class="about-text">
            Hello! I am Miguel, an Industrial and Systems Engineering student at Virginia Tech,
            originally from Sewickley, Pennsylvania. I am drawn to the places where process, data,
            and people meet - writing SOPs on a plant floor, mapping ERP data flows, or coordinating
            an engineering week for hundreds of students. I have interned in supply chain and process
            improvement at an abrasive minerals manufacturer and externed as a project engineer on a
            large-scale construction project. I am a Six Sigma Green Belt, I speak Portuguese,
            English, and Spanish, and I am always looking for the next opportunity to make a system
            run better.
          </p>
        </div>
      </section>

      <section class="section" id="education">
        <div class="wrap">
          <p class="kicker">Where I study</p>
          <h2 class="h2">Education</h2>
          <div class="timeline">
            <article class="job">
              <div class="job-head">
                <h3>Virginia Tech - B.S. in Industrial and Systems Engineering</h3>
                <span class="dates">Expected May 2029</span>
              </div>
              <p class="org">Blacksburg, VA</p>
              <ul>
                <li>Cumulative GPA: 3.62</li>
                <li>Fall 2025 Dean's List with Distinction</li>
                <li>Six Sigma Green Belt certified through IISE</li>
              </ul>
            </article>
          </div>
        </div>
      </section>

      <section class="section" id="experience">
        <div class="wrap">
          <p class="kicker">Explore my</p>
          <h2 class="h2">Experience</h2>
          <div class="timeline">
            {experience.map((job) => (
              <article class="job">
                <div class="job-head">
                  <h3>{job.role}</h3>
                  <span class="dates">{job.dates}</span>
                </div>
                <p class="org">{job.org}</p>
                <ul>
                  {job.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="leadership">
        <div class="wrap">
          <p class="kicker">Beyond the classroom</p>
          <h2 class="h2">Leadership &amp; Community Impact</h2>
          <div class="timeline">
            {leadership.map((job) => (
              <article class="job">
                <div class="job-head">
                  <h3>{job.role}</h3>
                  <span class="dates">{job.dates}</span>
                </div>
                <p class="org">{job.org}</p>
                <ul>
                  {job.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="skills">
        <div class="wrap">
          <p class="kicker">What I bring</p>
          <h2 class="h2">Core Skills</h2>
          <div class="skill-grid">
            {skillGroups.map((group) => (
              <div class="skill-card">
                <h3>{group.title}</h3>
                <ul class="chips">
                  {group.items.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="awards">
        <div class="wrap">
          <p class="kicker">Certifications and honors</p>
          <h2 class="h2">Awards</h2>
          <ul class="awards">
            {awards.map((a) => (
              <li>
                <span>
                  <span class="a-name">{a.name}</span>
                  <span class="a-sub">{a.sub}</span>
                </span>
                <span class="a-date">{a.date}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section" id="contact">
        <div class="wrap">
          <p class="kicker">Get in touch</p>
          <h2 class="h2">Contact Me</h2>
          <div class="contact">
            <a class="contact-row" href={"mailto:" + email}>
              <Fragment set:html={MAIL} />
              <span>{email}</span>
            </a>
            <a class="contact-row" href={"mailto:" + altEmail}>
              <Fragment set:html={MAIL} />
              <span>{altEmail}</span>
            </a>
            <a class="contact-row" href={"tel:" + phone}>
              <Fragment set:html={PHONE} />
              <span>{phone}</span>
            </a>
            <a class="contact-row" href={linkedin} target="_blank" rel="noopener noreferrer">
              <Fragment set:html={LI} />
              <span>linkedin.com/in/miguel-pinho1</span>
            </a>
            <div class="contact-row">
              <Fragment set:html={PIN} />
              <span>Sewickley, PA</span>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap">
        <p>Miguel Pinho &middot; Built with Astro and hosted on GitHub Pages</p>
      </div>
    </footer>
  </body>
</html>
