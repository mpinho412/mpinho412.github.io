    ]
  },
  {
    role: "E-Week Chair, Student Engineers' Council",
    org: "Virginia Tech College of Engineering - Blacksburg, VA",
    dates: "Sep 2025 - Present",
    bullets: [
      "Coordinate event logistics, vendor outreach, and budgeting for E-Week, an annual program engaging 500+ students across all engineering disciplines, working alongside 20+ student organizations and university staff.",
      "Help coordinate a week-long career fair bringing together 200+ companies, from defense contractors to corporate, for over 12,900 engineering students, handling vendor logistics and on-site operations."
    ]
  },
  {
    role: "ISE Ambassador",
    org: "Virginia Tech ISE Department - Blacksburg, VA",
    dates: "Apr 2026 - Present",
    bullets: [
      "Selected to represent the ISE department through student engagement events and initiatives across the College of Engineering."
    ]
  },
  {
    role: "Innovation Track Member",
    org: "Hybrid Electric Vehicle Team (HEVT), Virginia Tech - Blacksburg, VA",
    dates: "Jun 2026 - Present",
    bullets: [
      "Contribute to the Innovation Track Sub-Team on Virginia Tech's HEVT, working on vehicle systems design and engineering solutions."
    ]
  }
];

const leadership = [
  {
    role: "Peer Jury Foreman",
    org: "Quaker Valley High School - Juvenile Court's Community-Based Program",
    dates: "Sep 2023 - Jun 2025",
    bullets: [
      "Mediated 30+ court-eligible disciplinary cases as part of one of Pennsylvania's first peer jury programs, helping students avoid formal legal proceedings; sworn in by a local judge after training and an oath of confidentiality."
    ]
  },
  {
    role: "Founder, Latino Club",
    org: "Quaker Valley High School",
    dates: "Sep 2024 - Jun 2025",
    bullets: [
      "Founded the school's first Latino student organization, building programming around cultural advocacy and community identity."
    ]
  }
];

const skillGroups = [
  {
    title: "Technical & Engineering",
    items: ["Process analysis", "DMAIC methodology", "Control charts", "Process capability", "SolidWorks", "CAD", "MATLAB", "Python", "3D printing", "Arduino", "Raspberry Pi"]
  },
  {
    title: "Operations & Data",
    items: ["Sage 100 ERP", "SOP development", "Inventory mapping", "Kanban", "Kaizen", "Excel-based tracking tools", "Airtable", "Microsoft Office 365", "Power BI", "SQL", "Google Workspace", "Slack", "Notion"]
  },
  {
    title: "Infrastructure & Field",
    items: ["MEP systems monitoring", "RFI and submittal tracking (Procore)", "Site safety (PPE)", "Construction management workflows"]
  },
  {
    title: "Languages",
    items: ["Portuguese (Native)", "English (Native)", "Spanish (Working Proficiency)"]
  }
];

const awards = [
  { name: "Six Sigma Green Belt Certification", sub: "Institute of Industrial and Systems Engineers (IISE)", date: "April 2026" },
  { name: "Fall 2025 Dean's List with Distinction", sub: "Virginia Tech", date: "Feb 2026" },
  { name: "Graduating Senior Award", sub: "Quaker Valley High School", date: "May 2025" },
  { name: "SMART Certification", sub: "Carnegie Mellon Robotics Institute / ARM Institute", date: "Jun 2023" }
];
